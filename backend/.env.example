# Copy to .env and fill in real values. Never commit .env to git.

# MongoDB Atlas free-tier connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/exit_reminder?retryWrites=true&w=majority

# Database name (default: exit_reminder)
MONGO_DB=exit_reminder

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_string_minimum_64_chars

# Token lifetime in days (default: 7)
JWT_EXPIRE_DAYS=7
